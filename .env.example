# Required GitHub Actions secrets
CANVAS_ICS_URL=https://iu.instructure.com/feeds/calendars/user_xxx.ics
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional property-name overrides (defaults match the School HQ setup)
NOTION_TITLE_PROPERTY=Name
NOTION_DUE_PROPERTY=Due Date
NOTION_STATUS_PROPERTY=Status
NOTION_COURSE_PROPERTY=Course
NOTION_TYPE_PROPERTY=Type
NOTION_SOURCE_ID_PROPERTY=Source ID
NOTION_NOTES_PROPERTY=Notes

# Planner controls
TIMEZONE=America/Chicago
DAILY_STUDY_MINUTES=60
PLANNING_HORIZON_DAYS=14
OPTIONAL_STUDY_DAYS=4,5
EXCLUDED_COURSES=Career Development

